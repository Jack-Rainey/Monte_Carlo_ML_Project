# Run outputs (per-run artifacts under experiments/<run_id>/; ~1 GB each cycle)
experiments/

# Upstream GSound-SIR clone: a live build artifact, NOT vendored source.
# Pulled at a config-pinned commit SHA; reproducibility rests on that pin +
# the backend's installed==pinned check, never on a committed copy.
external/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# macOS (T7 external drive spawns AppleDouble resource forks)
._*
.DS_Store

# Claude Code user-local settings (project agents in .claude/agents/ ARE tracked)
.claude/settings.local.json

# Per-worktree lane identity, written by scripts/new_lane.py (docs/parallel_protocol.md).
# Never committed: each lane worktree carries a DIFFERENT one, and a committed copy
# would follow a merge into the main tree and tell the integrator it is a lane.
LANE.md
.claude/lane.json
