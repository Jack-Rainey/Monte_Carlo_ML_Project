{
  "experiment_name": "hoa_cnn_v1_full_ir",
  "stats_filename": "channel_stats.npz",
  "model": {
    "base_width": 32,
    "kernel_size": 9,
    "dilation_schedule": [1, 1, 2, 2, 4, 4],
    "width_schedule": [32, 32, 64, 64, 32, 32],
    "dropout_rate": 0.0,
    "residual_prediction": false
  },
  "training": {
    "seed": 42,
    "batch_size": 1,
    "epochs": 100,
    "learning_rate": 0.001,
    "huber_delta": 1.0,
    "early_stopping_patience": 12,
    "early_stopping_min_delta": 1e-05,
    "reduce_lr_factor": 0.5,
    "reduce_lr_patience": 6,
    "reduce_lr_min_lr": 1e-06,
    "mixed_precision": false
  },
  "evaluation_splits": [
    "valid",
    "test_id",
    "test_material_shift",
    "test_placement_shift",
    "test_geometry_shift"
  ]
}
